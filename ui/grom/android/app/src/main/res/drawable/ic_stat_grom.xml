<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome Grom bolt for notification small icons (alpha mask). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- Scale up vs logo path; still clears viewport edges (~1.4×). -->
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="1.4"
        android:scaleY="1.4">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M612,180 L300,512 H450 L412,844 L724,512 H574 Z"/>
    </group>
</vector>
